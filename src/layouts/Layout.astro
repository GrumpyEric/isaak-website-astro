---
import { NavbarHeader } from "@/components/NavbarHeader";
import { Footer } from "@/components/Footer";
import { colors } from "@/components/constants/colors";
import { MobileDrawer } from "@/components/MobileDrawer";
import { Modal } from "@/components/Modal";

interface Props {
  title: string;
}

const { title } = Astro.props;
const backgroundColor = colors.background;
const textColor = colors.text;
const accentColor = colors.accent;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Website of Isekku" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Modal client:only="react" />
    <MobileDrawer client:only="react" />
    <NavbarHeader client:only="react" />
    <slot />
    <Footer client:only="react" />
    <style is:global define:vars={{ backgroundColor, textColor, accentColor }}>
      html {
        color: var(--textColor);
        background: var(--backgroundColor);
      }

      html,
      body {
        width: 100%;
        /* height: 100vh; */
        margin: 0;
        overflow: auto;
      }

      @font-face {
        font-family: "Osaka";
        src: url("/fonts/osaka-re.ttf");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      .CopyrightPrivacy h2 {
        font-weight: bold;
      }

      #container {
        background-color: grey;
        display: flex;
        /* flex-wrap: wrap;
        flex-direction: column;
        height: 700%;
        width: auto; */
      }

      .module {
        /* height: 100%; */
        height: 100vh;
      }

      .dark {
        width: 100%;
        flex: 0 0 100%;
        background-color: rgb(99, 99, 99);
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
      }

      .white {
        width: 200%;
        flex: 0 0 200%;
        background-color: white;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .blue {
        width: 100%;
        flex: 0 0 100%;
        background-color: blue;
        display: flex;
        justify-content: flex-start;
        align-items: center;
      }

      .orange {
        width: 300%;
        flex: 0 0 300%;
        background-color: orange;
        display: flex;
        justify-content: center;
        align-items: center;
        border-right: 2px solid black;
      }
    </style>
  </body>
</html>
